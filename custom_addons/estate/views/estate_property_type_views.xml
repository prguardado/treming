<!-- Estate Property Views -->
<odoo>
    <data>

        <!-- Acción para estate_property_offer -->
        <record id="action_estate_property_offer" model="ir.actions.act_window">
            <field name="name">Ofertas</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('property_type_id','=',active_id)]</field>
        </record>

        <record id="estate_property_type_view_search" model="ir.ui.view">
            <field name="name">estate.property.type.search</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <search string="Búsquedas">
                    <field name="name"/>
                    <separator/>
                    <filter string="Archivados" name="active" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- 1. Form View (Vista de formulario para crear/editar tipos de propiedades) -->
        <record id="view_estate_property_type_form" model="ir.ui.view">
            <field name="name">estate.property.type.form</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <form string="Tipos de Propiedades">
                    <header>

                    </header>
                    <sheet>

                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_estate_property_offer)d" type="action" class="oe_stat_button" icon="fa-money">
                                <field name="offer_count" widget="statinfo" string="Ofertas"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>                                
                                <field name="name" class="mb16" placeholder="Nuevo tipo de propiedad"/>
                            </h1>
                        </div>

                        <notebook>
                            <page string='Propiedades'>
                                <field name='property_ids'>
                                    <list>
                                        <field name='name'/>
                                        <field name='expected_price'/>
                                        <field name='state'/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        
                    </sheet>
                </form>
            </field>
        </record>

        <!-- 2. List View (Vista de lista para mostrar todos los tipos de propiedades) -->
        <record id="view_estate_property_type_list" model="ir.ui.view">
            <field name="name">estate.property.type.list</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <list string="Tipo de Propiedades">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name='active'/>
                </list>
            </field>
        </record>

        <!-- 2. List View (Vista de lista para mostrar las ofertas) -->
        <record id="view_estate_property_offer_list" model="ir.ui.view">
            <field name="name">estate.property.offer.list</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="Ofertas de Propiedades"
                        decoration-danger="status == 'refused'"
                        decoration-success="status == 'accepted'">
                    <field name="price" width="25%" sum="price"/>
                    <field name="partner_id" width="25%"/>
                    <field name="validity" width="25%"/>
                    <field name="date_deadline" width="25%"/>
                </list>
            </field>
        </record>

        <!-- Acción para abrir la vista de tipos de propiedades -->
        <record id="action_estate_property_type" model="ir.actions.act_window">
            <field name="name">Estate Property Types</field>
            <field name="res_model">estate.property.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Estate Property Type record!
                </p>
            </field>
         </record>

    </data>
 </odoo>