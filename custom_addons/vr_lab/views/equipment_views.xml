<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Form View (Vista de detalle al abrir un registro) -->
    <record id="view_vr_equipment_form" model="ir.ui.view">
        <field name="name">vr.equipment.form</field>
        <field name="model">vr.equipment</field>
        <field name="arch" type="xml">
            <form string="VR Equipment">
                <header>
                    <!-- Aquí se coloca el botón que ejecuta la función de Python que creamos antes -->
                    <button name="action_mark_maintenance" type="object" string="Send to Maintenance" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ej. Visor HTC VIVE..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="serial_number"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="is_available"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Technical Notes">
                            <field name="notes" placeholder="Agrega notas sobre el estado del equipo..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. List View (Vista de lista principal, anteriormente Tree View) -->
    <record id="view_vr_equipment_list" model="ir.ui.view">
        <field name="name">vr.equipment.list</field>
        <field name="model">vr.equipment</field>
        <field name="arch" type="xml">
            <list string="VR Equipment"> <!-- Aquí está el cambio clave -->
                <field name="name"/>
                <field name="brand"/>
                <field name="serial_number"/>
                <field name="is_available"/>
            </list>
        </field>
    </record>

    <!-- 3. Action (Lo que sucede al hacer clic en el menú) -->
    <record id="action_vr_equipment" model="ir.actions.act_window">
        <field name="name">VR Equipment</field>
        <field name="res_model">vr.equipment</field>
        <!-- EL CAMBIO ESTÁ AQUÍ: de tree,form a list,form -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first VR equipment record!
            </p>
        </field>
    </record>

    <!-- 4. Menús (Para que aparezca en la barra de navegación) -->
    <!-- Menú raíz (Aparece en la pantalla de inicio de apps) -->
    <menuitem id="menu_vr_lab_root" name="VR Lab Inventory" sequence="10"/>
    
    <!-- Submenú que ejecuta la acción -->
    <menuitem id="menu_vr_equipment" 
              name="Equipment" 
              parent="menu_vr_lab_root" 
              action="action_vr_equipment" 
              sequence="10"/>

</odoo>