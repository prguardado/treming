<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <template id="report_orden_template_view">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div t-attf-class="p-3 mb-4 rounded border {{ 'bg-light text-dark' if o.estado == 'borrador' else 'bg-warning text-dark' if o.estado == 'urgente' else 'bg-success text-white' }}">
                                <h2>
                                    <span t-out="o.name"/>
                                </h2>
                                <p>Estado de la Orden: <strong><span t-out="o.estado"/></strong></p>
                            </div>

                            <div class="row mb-4">
                                <div class="col-6">
                                    <strong>Proveedor:</strong>
                                    <div t-out="o.proveedor_id.name"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Fecha Emisión:</strong>
                                    <div t-out="o.fecha"/>
                                </div>
                            </div>

                            <table class="table table-sm mt-4">
                                <thead>
                                    border-top: 1px solid black;
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">Precio Unitario</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="total_acumulado" t-value="0.0"/>

                                    <t t-foreach="o.linea_ids" t-as="linea">
                                        <tr>
                                            <td t-out="linea.producto"/>
                                            <td class="text-end" t-out="linea.cantidad"/>
                                            <td class="text-end" t-out="linea.precio_unitario"/>
                                            
                                            <t t-set="subtotal" t-value="linea.cantidad * linea.precio_unitario"/>
                                            <td class="text-end" t-out="subtotal"/>
                                            
                                            <t t-set="total_acumulado" t-value="total_acumulado + subtotal"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <div class="row justify-content-end mt-4">
                                <div class="col-4 border-top">
                                    <p class="d-flex justify-content-between mt-2">
                                        <span><strong>Total Final:</strong></span>
                                        <span t-out="total_acumulado"/>
                                    </p>

                                    <div t-if="o.estado == 'urgente'" class="alert alert-danger text-center mt-2">
                                        <strong>¡ATENCIÓN!:</strong> Despachar esta orden mediante canales logísticos prioritarios.
                                    </div>
                                    <div t-else="" class="text-muted text-center small mt-2">
                                        Sujeto a los términos estándar de abastecimiento comercial.
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>